[configuration]

entry_symbol = "taudplay_library_init"
compatibility_minimum = "4.2"

[libraries]

linux.debug.x86_64 = "res://addons/taudplay/bin/libtaudplay.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/taudplay/bin/libtaudplay.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/taudplay/bin/libtaudplay.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/taudplay/bin/libtaudplay.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://addons/taudplay/bin/libtaudplay.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/taudplay/bin/libtaudplay.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://addons/taudplay/bin/libtaudplay.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/taudplay/bin/libtaudplay.windows.template_release.x86_32.dll"
macos.debug = "res://addons/taudplay/bin/libtaudplay.macos.template_debug.framework"
macos.release = "res://addons/taudplay/bin/libtaudplay.macos.template_release.framework"
ios.debug = "res://addons/taudplay/bin/libtaudplay.ios.template_debug.a"
ios.release = "res://addons/taudplay/bin/libtaudplay.ios.template_release.a"
android.debug.arm64 = "res://addons/taudplay/bin/libtaudplay.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/taudplay/bin/libtaudplay.android.template_release.arm64.so"
android.debug.x86_64 = "res://addons/taudplay/bin/libtaudplay.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/taudplay/bin/libtaudplay.android.template_release.x86_64.so"
web.debug.wasm32 = "res://addons/taudplay/bin/libtaudplay.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://addons/taudplay/bin/libtaudplay.web.template_release.wasm32.wasm"

[icons]

AudioStreamTaud = "res://addons/taudplay/icons/AudioStreamTaud.svg"
